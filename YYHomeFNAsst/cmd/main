#!/bin/bash
# YYHomeFNAsst 启停与状态检查脚本

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SERVICE="${TRIM_APPDEST:-${APP_ROOT}/target}/service/main.py"
PID_FILE="${TRIM_PKGVAR:-/tmp/fnasst}/app.pid"
LOG_FILE="${TRIM_PKGVAR:-/tmp/fnasst}/server.log"

get_pid() {
    if [ -f "$PID_FILE" ]; then
        cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
    fi
}

is_running() {
    local pid
    pid=$(get_pid)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then
            exit 0
        fi
        if [ ! -f "$SERVICE" ]; then
            echo "服务文件缺失：${SERVICE}" > "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
        if ! command -v python3 >/dev/null 2>&1; then
            echo "未找到 python3，无法启动 YYHomeFNAsst。请先安装 python3 后重试。" > "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
        if ! command -v hdparm >/dev/null 2>&1; then
            echo "未找到 hdparm，无法启动 YYHomeFNAsst。请先安装 hdparm 后重试。" > "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
        mkdir -p "$(dirname "$PID_FILE")"
        : > "${LOG_FILE}"
        YYHOMEFNASST_PORT="${TRIM_SERVICE_PORT:-8327}" nohup python3 "${SERVICE}" >> "${LOG_FILE}" 2>&1 &
        echo $! > "${PID_FILE}"
        sleep 1
        if is_running; then
            exit 0
        fi
        echo "YYHomeFNAsst 启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
        exit 1
        ;;
    stop)
        pid=$(get_pid)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            for _ in $(seq 1 20); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.5
            done
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "${PID_FILE}"
        exit 0
        ;;
    status)
        if is_running; then
            exit 0
        fi
        rm -f "${PID_FILE}" 2>/dev/null
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
